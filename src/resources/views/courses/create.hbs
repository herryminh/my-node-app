<div class="m-4">
    <h3> THÊM SẢN PHẨM </h3>
    <form method="post" action="/courses/store">
            <div div class="form-group "> 
                <label class="ms-1" for="ten_san_pham">  Tên sản phẩm</label> 
                <input type="text" class="form-control" id="ten_san_pham" name="ten_san_pham">
            </div>
            <div div class="form-group "> 
                <label class="ms-1" for="don_gia">  đơn giá</label> 
                <input type="text" class="form-control" id="don_gia" name="don_gia">
            </div>
            <div div class="form-group "> 
                <label class="ms-1" for="don_vi">  dạng</label> 
                <input type="text" class="form-control" id="don_vi" name="don_vi">
            </div>
            <div class="mb-3">
                <label class="form-label">Trạng thái</label>
                <select class="form-select" name="trang_thai" required>
                    <option value="còn hàng">Còn hàng</option>
                    <option value="hết hàng">Hết hàng</option>
                </select>
            </div>
        <button type="submit" class="btn btn-primary mt-2">lưu đơn hàng</button>
    </form>
</div>