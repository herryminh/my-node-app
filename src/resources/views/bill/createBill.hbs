<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<div class="container my-4">
    <h2>Hóa đơn</h2>
    <form id="invoice-form" action="/bill/store" method="POST">
        <div class="mb-3">
            <label for="client" class="form-label">Tên khách hàng</label>
            <select id="client" name="pharmacyName" class="form-select select2-search" required>
                <option value="">-- Chọn khách hàng --</option>
                {{#each clients}}
                    <option 
                    value="{{this.name}}" 
                    data-address="{{this.address}}"
                    data-phone="{{this.phone}}">
                        {{this.name}} - {{this.phone}} - {{this.address}}
                    </option>
                {{/each}}
            </select>
            <input type="hidden" name="pharmacyAddress" id="pharmacyAddressInput">
            <input type="hidden" name="customerPhone" id="customerPhoneInput">
        </div>

        <select id="course-options-template" style="display: none;" disabled>
            <option value="">-- Chọn sản phẩm --</option>
            {{#each courses}}
                <option value="{{this.ten_san_pham}}" data-price="{{this.don_gia}}">
                    {{this.ten_san_pham}} - {{this.don_gia}} đồng
                </option>
            {{/each}}
        </select>

        <h5>Danh sách thuốc</h5>
        <div class="table-responsive-sm">
            <table class="table table-bordered" id="productsTable">
                <thead class="table-light">
                    <tr>
                        <th>Tên thuốc</th>
                        <th>Số lượng</th>
                        <th>Giá (đồng)</th>
                        <th>Tổng tiền (đồng)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="product-row">
                        <td>
                            <select name="products[0][name]" class="form-select course-select" required>
                                <option value="">-- Chọn sản phẩm --</option>
                                {{#each courses}}
                                    <option value="{{this.ten_san_pham}}" data-price="{{this.don_gia}}">
                                        {{this.ten_san_pham}} - {{this.don_gia}} đồng
                                    </option>
                                {{/each}}
                            </select>
                        </td>
                        <td><input type="number" name="products[0][quantity]" class="form-control quantity" min="1" value="1" required /></td>
                        <td><input type="number" name="products[0][price]" class="form-control pricee" value="0" readonly /></td>
                        <td><input type="number" name="products[0][total]" class="form-control total" value="0" readonly /></td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-row">Xóa</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <button type="button" class="btn btn-secondary mb-3" id="addProductBtn">Thêm thuốc</button>
        
        <h5>Sản phẩm tặng thêm</h5>
        <div class="table-responsive-sm">
            <table class="table table-bordered" id="giftProductsTable">
                <thead class="table-light">
                    <tr>
                        <th>Tên thuốc</th>
                        <th>Số lượng</th>
                        <th>Giá (đồng)</th>
                        <th>Tổng tiền (đồng)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="gift-product-row">
                        <td>
                            <select name="giftProducts[0][name]" class="form-select course-select">
                                <option value="">-- Chọn sản phẩm --</option>
                                {{#each courses}}
                                    <option value="{{this.ten_san_pham}}" data-price="{{this.don_gia}}">
                                        {{this.ten_san_pham}} - {{this.don_gia}} đồng
                                    </option>
                                {{/each}}
                            </select>
                        </td>
                        <td><input type="number" name="giftProducts[0][quantity]" class="form-control quantity" min="0" value="0" /></td>
                        <td><input type="number" name="giftProducts[0][price]" class="form-control pricee" value="0" readonly /></td>
                        <td><input type="number" name="giftProducts[0][total]" class="form-control total" value="0" readonly /></td>
                        <td><button type="button" class="btn btn-danger btn-sm remove-gift-row">Xóa</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <button type="button" class="btn btn-secondary mb-3" id="add-gift-row">Tặng thêm</button>

        <div class="d-flex justify-content-end price">
            <h5>Tổng hóa đơn: <span id="grandTotal" class="text-danger fw-bold">0</span> đồng</h5>
            <input type="hidden" name="totalAmount" id="hiddenGrandTotal" value="0">
        </div>

        <button type="submit" class="mt-3 btn btn-primary">Lưu hóa đơn</button>
    </form>
</div>

<div class="modal fade" id="confirm-save-modal" tabindex="-1" aria-labelledby="confirmSaveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmSaveModalLabel">Xác nhận tạo hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn lưu và tạo hóa đơn này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btn-save-invoice">Đồng ý</button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive-sm { overflow-x: auto; }
    .table-responsive-sm table { white-space: nowrap; }
    .select2-container .select2-selection--single {
        height: 38px !important; border: 1px solid #ced4da !important; border-radius: 0.375rem !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 36px !important; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

    // Khởi tạo các biến
    const invoiceForm = document.getElementById('invoice-form');
    const productTableBody = document.querySelector('#productsTable tbody');
    const giftProductTableBody = document.querySelector('#giftProductsTable tbody');
    // Lấy nguyên bộ danh sách thuốc cực kì "sạch sẽ" từ thẻ select ẩn
    const optionsHTML = document.getElementById('course-options-template').innerHTML; 
    const grandTotalSpan = document.getElementById('grandTotal');
    const hiddenGrandTotalInput = document.getElementById('hiddenGrandTotal');
    
    // Select2 cho khách hàng
   $('#client').select2({ width: '100%' }).on('change', function() {

    const selectedOption = $(this).find('option:selected');

    document.getElementById('pharmacyAddressInput').value =
        selectedOption.attr('data-address') || '';

    document.getElementById('customerPhoneInput').value =
        selectedOption.attr('data-phone') || '';
});

    // Tính toán
    function calculateRowTotal(row) {
        const qty = Number(row.querySelector('.quantity').value) || 0;
        const price = Number(row.querySelector('.pricee').value) || 0;
        row.querySelector('.total').value = qty * price;
    }

    function calculateGrandTotal() {
        let total = 0;
        document.querySelectorAll('.product-row .total').forEach(input => total += Number(input.value) || 0);
        grandTotalSpan.innerText = total.toLocaleString('vi-VN');
        hiddenGrandTotalInput.value = total;
    }

    function updateNames(rowClass, arrayName) {
        document.querySelectorAll(`.${rowClass}`).forEach((row, index) => {
            row.querySelector('.course-select').name = `${arrayName}[${index}][name]`;
            row.querySelector('.quantity').name = `${arrayName}[${index}][quantity]`;
            row.querySelector('.pricee').name = `${arrayName}[${index}][price]`;
            row.querySelector('.total').name = `${arrayName}[${index}][total]`;
        });
    }

    // Gắn sự kiện cho DÒNG SẢN PHẨM
    function attachProductEvents(row) {
        const $select = $(row).find('.course-select');
        $select.select2({ width: '100%' }).on('change', function() {
            row.querySelector('.pricee').value = Number($(this).find('option:selected').attr('data-price')) || 0;
            calculateRowTotal(row); calculateGrandTotal();
        });
        row.querySelector('.quantity').addEventListener('input', () => {
            calculateRowTotal(row); calculateGrandTotal();
        });
        row.querySelector('.remove-row').addEventListener('click', () => {
            if (document.querySelectorAll('.product-row').length > 1) {
                $select.select2('destroy'); row.remove();
                updateNames('product-row', 'products'); calculateGrandTotal();
            } else alert("Không thể xóa dòng sản phẩm duy nhất.");
        });
    }

    // Gắn sự kiện cho DÒNG QUÀ TẶNG
    function attachGiftEvents(row) {
        const $select = $(row).find('.course-select');
        $select.select2({ width: '100%' }).on('change', function() {
            row.querySelector('.pricee').value = Number($(this).find('option:selected').attr('data-price')) || 0;
            calculateRowTotal(row); // Không tính vào tổng tiền
        });
        row.querySelector('.quantity').addEventListener('input', () => calculateRowTotal(row));
        row.querySelector('.remove-gift-row').addEventListener('click', () => {
            if (document.querySelectorAll('.gift-product-row').length > 1) {
                $select.select2('destroy'); row.remove();
                updateNames('gift-product-row', 'giftProducts');
            } else alert("Không thể xóa dòng quà tặng duy nhất.");
        });
    }

    // Khởi tạo cho dòng đầu tiên
    attachProductEvents(document.querySelector('.product-row'));
    attachGiftEvents(document.querySelector('.gift-product-row'));

    // ===============================================
    // THÊM SẢN PHẨM BẰNG HTML MỚI TINH
    // ===============================================
    document.getElementById('addProductBtn').addEventListener('click', () => {
        const tr = document.createElement('tr');
        tr.className = 'product-row';
        tr.innerHTML = `
            <td><select class="form-select course-select" required>${optionsHTML}</select></td>
            <td><input type="number" class="form-control quantity" min="1" value="1" required /></td>
            <td><input type="number" class="form-control pricee" value="0" readonly /></td>
            <td><input type="number" class="form-control total" value="0" readonly /></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-row">Xóa</button></td>
        `;
        productTableBody.appendChild(tr);
        attachProductEvents(tr);
        updateNames('product-row', 'products');
    });

    // ===============================================
    // THÊM QUÀ TẶNG BẰNG HTML MỚI TINH
    // ===============================================
    document.getElementById('add-gift-row').addEventListener('click', () => {
        const tr = document.createElement('tr');
        tr.className = 'gift-product-row';
        tr.innerHTML = `
            <td><select class="form-select course-select">${optionsHTML}</select></td>
            <td><input type="number" class="form-control quantity" min="0" value="0" /></td>
            <td><input type="number" class="form-control pricee" value="0" readonly /></td>
            <td><input type="number" class="form-control total" value="0" readonly /></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-gift-row">Xóa</button></td>
        `;
        giftProductTableBody.appendChild(tr);
        attachGiftEvents(tr);
        updateNames('gift-product-row', 'giftProducts');
    });

    // Form Submit
    const confirmModal = new bootstrap.Modal(document.getElementById('confirm-save-modal'));
    invoiceForm.addEventListener('submit', (e) => { e.preventDefault(); confirmModal.show(); });
    document.getElementById('btn-save-invoice').addEventListener('click', () => invoiceForm.submit());

});
</script>