<div class="mt-4">
  <div class="container my-4  pt-5">
    <div class="row g-3">
      {{#each courses}}
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between">
              <h6 class="fw-bold mb-1">{{this.ten_san_pham}}</h6>
              <span class="text-end text-muted">Đ.giá : <strong>{{this.don_gia}}</strong>/Hộp</span>
            </div>
            <div class="d-flex justify-content-between">
                <div class="mt-3 d-flex gap-2">
                                
                            <button class="btn btn-outline-primary rounded-circle px-3 py-1">1</button>
                            <button class="btn btn-outline-primary rounded-circle px-3 py-1">5</button>
                            <button class="btn btn-outline-primary rounded-circle px-3 py-1">20</button>
                </div>
                     {{#if (eq this.trang_thai "hết hàng")}}
                        <button class="btn btn-secondary" disabled>Hết hàng</button>
                    {{else}}
                    <button class="btn btn-primary">
                        <a href="/bill/create" class="btn btn-primary p-1">Lên đơn</a>
                    </button>
                    {{/if}}
                    </div>
            
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</div>
